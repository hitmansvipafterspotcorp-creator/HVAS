# HVAS backend configuration (copy to .env or set in your host's dashboard)
PORT=8787
HVAS_DATA_DIR=./data          # where the SQLite DB + venue signing key live

# Privileged role access codes (issued by the venue). Change these!
HVAS_STAFF_CODE=DOOR850
HVAS_HOST_CODE=HOST850

# Lip Sync Bingo: TV auto-media (YouTube search + playback). No key = the
# search panel shows "not connected" and the feature just stays off.
# YOUTUBE_API_KEY=

# HitKoin: mints to a member's auto-created wallet the moment a real payment
# confirms (PayPal webhook, or staff confirming a Zelle/cash claim). No
# HITKOIN_CONTRACT_ADDRESS = the feature just stays off, payments still work
# normally. See server/blockchain/README.md to deploy the contract first.
# HITKOIN_CONTRACT_ADDRESS=
# HITKOIN_RPC_URL=                 # e.g. an Alchemy/Infura/QuickNode Polygon endpoint
# HITKOIN_MINTER_PRIVATE_KEY=      # the venue's own signing wallet — keep this secret
# HITKOIN_PER_DOLLAR=100           # HitKoin minted per $1 spent (default 100)

# Mesh (optional — background peer-to-peer between door nodes)
# MESH_PORT=9944               # accept peer connections on this port
# MESH_PEERS=door-a:9944,door-b:9944   # comma-separated host:port of peers
# NODE_ID=door-1

# ── Sending sign-in codes (optional, and the reason a returning member can
#    sign themselves back in) ─────────────────────────────────────────────
#
# With NOTHING set here, the venue cannot send a code, and it says so honestly
# rather than pretending. A new person still signs up unaided: the code comes
# straight back on their screen, which is safe because they are creating an
# identity nobody holds and there is a human at the door looking at them.
#
# An EXISTING member is different. Echoing a code back for a contact somebody
# already holds is account takeover — type their number, read the code off your
# own screen, and you are them. So the venue refuses, and a named member of
# staff issues them one instead (Team → the member → sign-in code). That works
# with none of this set, and it needs a person every time.
#
# Set one of these and it stops needing a person. Email has no carrier
# paperwork and works the same day; SMS through Twilio needs A2P 10DLC
# registration first, which takes days to weeks — do not count on it for an
# opening night. Either can also be set from inside the app (Team → sign-in
# setup) instead of here; the app's setting wins over these.
#
# MAIL_FROM=codes@yourdomain.com     # required by every email option below
# RESEND_API_KEY=
# POSTMARK_TOKEN=
# SENDGRID_API_KEY=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# TWILIO_ACCOUNT_SID=                # SMS. Needs A2P 10DLC first — see above.
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+18505550000
