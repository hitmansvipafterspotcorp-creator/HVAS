# HVAS backend configuration (copy to .env or set in your host's dashboard)
PORT=8787
HVAS_DATA_DIR=./data          # where the SQLite DB + venue signing key live

# Privileged role access codes (issued by the venue). Change these!
HVAS_STAFF_CODE=DOOR850
HVAS_HOST_CODE=HOST850

# Lip Sync Bingo: TV auto-media (YouTube search + playback). No key = the
# search panel shows "not connected" and the feature just stays off.
# YOUTUBE_API_KEY=

# HitKoin: mints to a member's auto-created wallet the moment a real payment
# confirms (PayPal webhook, or staff confirming a Zelle/cash claim). No
# HITKOIN_CONTRACT_ADDRESS = the feature just stays off, payments still work
# normally. See server/blockchain/README.md to deploy the contract first.
# HITKOIN_CONTRACT_ADDRESS=
# HITKOIN_RPC_URL=                 # e.g. an Alchemy/Infura/QuickNode Polygon endpoint
# HITKOIN_MINTER_PRIVATE_KEY=      # the venue's own signing wallet — keep this secret
# HITKOIN_PER_DOLLAR=100           # HitKoin minted per $1 spent (default 100)

# Mesh (optional — background peer-to-peer between door nodes)
# MESH_PORT=9944               # accept peer connections on this port
# MESH_PEERS=door-a:9944,door-b:9944   # comma-separated host:port of peers
# NODE_ID=door-1
